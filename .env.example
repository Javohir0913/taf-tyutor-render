# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring

# Lokal sinovda True, serverda ALBATTA False
DEBUG=True

# Serverda yangi kalit yarating:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Sayt ochiladigan domen(lar), vergul bilan
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS domen(lar), masalan: https://tyutor.example.uz
CSRF_TRUSTED_ORIGINS=

# Domen + SSL bo'lsa True. Vaqtincha IP orqali sinov bo'lsa False
USE_HTTPS=True

# Pasport fayllari papkasi (bo'sh qoldirilsa: loyiha ichidagi private_media/)
PRIVATE_MEDIA_ROOT=
